<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rlatnfla.demo1.coremusic.infrastructure.mybatis.mapper.ArtistMyBatisMapper">

  <sql id="selectArtist">
    SELECT id, name, image_url
    FROM artist
  </sql>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO artist (name, image_url)
    VALUES (#{entity.name}, #{entity.imageUrl})
  </insert>

  <update id="update">
    UPDATE artist
    SET name = #{entity.name},
        image_url = #{entity.imageUrl}
    WHERE id = #{entity.id}
  </update>

  <select id="findById" resultType="com.rlatnfla.demo1.coremusic.infrastructure.mybatis.entity.ArtistMyBatisEntity">
    <include refid="selectArtist"/>
    WHERE id = #{id}
  </select>

  <select id="findAllByName" resultType="com.rlatnfla.demo1.coremusic.infrastructure.mybatis.entity.ArtistMyBatisEntity">
    <include refid="selectArtist"/>
    WHERE name = #{name}
  </select>

</mapper>